# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: force one preferred model before the built-in GLM/Z.AI fallback chain.
# 继续走 OpenRouter；这里只切模型，不需要智谱/BigModel key。
# 若失效见 ai.js 的 DEFAULT_MODELS 或查 openrouter.ai/models.
OPENROUTER_MODEL=z-ai/glm-4.5-air

# --- Runtime identity (required) ---
# Your own WhatsApp phone number (no '+' or spaces)
MY_NUMBER=60xxxxxxxxx
# Target group ID for the morning news broadcast (use !groups to find it)
GROUP_ID=1203xxxxxxxxxxxx@g.us
# Comma-separated WhatsApp JIDs allowed to call !website
WEBSITE_WHITELIST=60xxxxxxxxx@c.us

# --- Daily news schedule (24h) ---
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0

# --- Daily fitness coach reminder (增肌每日提醒, 24h, scheduleTz 时区) ---
# 默认开启, 中午 12:00 把当天训练/休息计划发给 MY_NUMBER 本人.
FITNESS_ENABLED=true
FITNESS_HOUR=12
FITNESS_MINUTE=0
# 可选: 指定接收方 WhatsApp ID (留空=发给 MY_NUMBER 本人)
# FITNESS_TARGET=60xxxxxxxxx@c.us

# --- Daily FX rate push (每日汇率推送, 24h, scheduleTz 时区) ---
# USD→MYR / SGD→MYR live 汇率 + 近7天高低 + 兑换建议 + AI走势, 默认晚上20:00发到群组.
FX_ENABLED=true
FX_HOUR=20
FX_MINUTE=0
# 可选: 覆盖接收方 (留空=发到 GROUP_ID, 无群则发给 MY_NUMBER)
# FX_TARGET=1203xxxxxxxxxxxx@g.us
# 设为 false 关闭 AI 走势分析部分
FX_AI=true
# 汇率走势分析现在统一走 OpenRouter GLM；不再需要本机 Claude CLI。

# --- Auto-reply (optional) ---
# AUTO_REPLY_ENABLED=true
# AUTO_REPLY_MESSAGE=ok

# --- Conversation context / 对话上下文 (short-term memory) ---
# 每个会话保留最近 N 条消息给聊天模型做上下文, 超出自动删除最旧的 (纯内存, 不做空闲超时).
CONTEXT_MAX_MESSAGES=200
# 会话数上限, 超出淘汰最久未活动的, 防止内存无限增长
# CONTEXT_MAX_CHATS=200

# --- Clarification / ask-user threshold module (optional) ---
# Set CLARIFY_ENABLED=true to turn on the slot-filling clarification flow.
# Gate it with CLARIFY_WHITELIST until you've validated the behaviour.
CLARIFY_ENABLED=false
CLARIFY_WHITELIST=
CLARIFY_THRESHOLD=0.1
CLARIFY_MAX_ROUNDS=20
CLARIFY_SOFT_WARN=10
CLARIFY_TTL_MS=1800000
# CLARIFY_MODEL=
